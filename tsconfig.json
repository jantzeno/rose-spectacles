{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "resolveJsonModule": true,
        "incremental": true,
        "tsBuildInfoFile": "node_modules/.cache/rose-spectacles.tsbuildinfo",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "types": ["node", "vite/client", "vitest/globals"]
    },
    "include": ["src/**/*", "gallery/**/*", "*.config.ts", "scripts/**/*.ts"]
}
